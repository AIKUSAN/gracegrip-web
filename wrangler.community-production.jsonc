{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gracegrip-community-room-production",
  "main": "workers/community-room.js",
  "compatibility_date": "2026-09-25",
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY_ROOM", "class_name": "CommunityRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CommunityRoom"] }]
}
