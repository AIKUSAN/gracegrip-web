{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gracegrip-feedback-retention",
  "account_id": "ab8306e92557d6b7fcfd56774bb9c2e5",
  "main": "./workers/feedback-retention.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["NEON_DATABASE_URL"] },
  "vars": { "NEON_RETENTION_REQUIRED": "true" },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "gracegrip-feedback-production",
      "database_id": "6682fbb5-1d24-4ced-b443-0aa6ca253857"
    }
  ],
  "env": {
    "preview": {
      "name": "gracegrip-feedback-retention-preview",
      "workers_dev": false,
      "preview_urls": false,
      "secrets": { "required": [] },
      "triggers": { "crons": [] },
      "vars": { "NEON_RETENTION_REQUIRED": "false" },
      "d1_databases": [
        {
          "binding": "FEEDBACK_DB",
          "database_name": "gracegrip-feedback-preview",
          "database_id": "eadf0da8-20f2-4fd4-a55f-00119682a6c2"
        }
      ]
    }
  }
}
